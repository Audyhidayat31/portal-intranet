generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                   @id @default(cuid())
  nip                 String                   @unique
  name                String
  email               String                   @unique
  password            String
  roleId              String
  role                Role                     @relation(fields: [roleId], references: [id])
  status              String                   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  profile             EmployeeProfile?
  contents            Content[]                @relation("AuthorContents")
  employeePosts       EmployeePost[]           @relation("AuthorPosts")
  postComments        PostComment[]
  consultations       ConsultationTopic[]      @relation("UserConsultations")
  consultationReplies ConsultationReply[]
  activityLogs        ActivityLog[]
  beritaList          Berita[]                 @relation("BeritaAuthor")
  pengumumanList      Pengumuman[]             @relation("PengumumanAuthor")
  agendaList          AgendaKegiatan[]         @relation("AgendaAuthor")
  laporanList         LaporanPerjalananDinas[] @relation("LaporanAuthor")
  dokumenList         DokumenIntern[]          @relation("DokumenAuthor")
  opiniList           CoretanOpini[]           @relation("OpiniAuthor")
  humorList           HumorPegawai[]           @relation("HumorAuthor")
  jelajahList         JelajahBumi[]            @relation("JelajahAuthor")
  keluargaList        KabarKeluarga[]          @relation("KeluargaAuthor")
  bijakList           KalimatBijak[]           @relation("BijakAuthor")
  karyaList           KaryaAkademik[]          @relation("KaryaAuthor")
  tipsList            TipsGayaHidup[]          @relation("TipsAuthor")
  olahragaList        Olahraga[]               @relation("OlahragaAuthor")
  tahukahList         TahukahAnda[]            @relation("TahukahAuthor")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@map("pengguna")
}

model EmployeeProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nip           String    @unique
  fullName      String
  position      String // Jabatan
  unitKerja     String // Unit Kerja / Direktorat
  golRuang      String? // e.g. IV/a - Pembina
  phone         String?
  avatarUrl     String?   @db.Text
  birthDate     DateTime?
  education     String?   @db.Text // Riwayat pendidikan
  careerHistory String?   @db.Text // Riwayat pekerjaan/posisi
  achievements  String?   @db.Text // Prestasi
  bio           String?   @db.Text // Catatan biografi singkat
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("profil_pegawai")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // ADMINISTRATOR, PEGAWAI
  description String?          @db.Text
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("peran")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique // e.g. USERS_READ, USERS_WRITE, CONTENTS_WRITE
  module      String // e.g. USERS, ROLES, CONTENTS, LOGS
  description String?          @db.Text
  roles       RolePermission[]

  @@map("izin")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("peran_izin")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  group       String // KABAR_KEDINASAN, ANTAR_PEGAWAI
  description String?   @db.Text
  contents    Content[]
  createdAt   DateTime  @default(now())

  @@map("kategori")
}

model Content {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?   @db.Text
  body        String    @db.LongText
  coverImage  String?   @db.LongText
  type        String // NEWS, ANNOUNCEMENT, AGENDA, BUSINESS_TRIP, INTERNAL_DOCUMENT
  status      String    @default("TERBIT") // DRAFT, PUBLISHED, ARCHIVED
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  authorId    String
  author      User      @relation("AuthorContents", fields: [authorId], references: [id])
  publishedAt DateTime  @default(now())

  // Specific metadata fields
  eventStartDate  DateTime? // For AGENDA
  eventEndDate    DateTime? // For AGENDA
  eventLocation   String? // For AGENDA
  destinationCity String? // For BUSINESS_TRIP
  attachmentUrl   String?   @db.LongText // For INTERNAL_DOCUMENT or ANNOUNCEMENT
  attachmentName  String?
  fileSize        String?
  isPinned        Boolean   @default(false)
  viewCount       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("konten")
}

model EmployeePost {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  body         String        @db.LongText
  categorySlug String // opini, humor, jelajah-bumi, kabar-keluarga, kalimat-bijak, karya-akademik, tips-gaya-hidup, olahraga, tahukah-anda
  authorId     String
  author       User          @relation("AuthorPosts", fields: [authorId], references: [id])
  coverImage   String?       @db.Text
  status       String        @default("TERBIT") // DRAFT, PUBLISHED, ARCHIVED
  likesCount   Int           @default(0)
  viewsCount   Int           @default(0)
  comments     PostComment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("postingan_pegawai")
}

model PostComment {
  id        String       @id @default(cuid())
  postId    String
  post      EmployeePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String       @db.Text
  createdAt DateTime     @default(now())

  @@map("komentar_postingan")
}

model ConsultationTopic {
  id        String              @id @default(cuid())
  title     String
  category  String // KEPEGAWAIAN, IT, KESEHATAN
  question  String              @db.Text
  authorId  String
  author    User                @relation("UserConsultations", fields: [authorId], references: [id], onDelete: Cascade)
  status    String              @default("OPEN") // OPEN, ANSWERED, CLOSED
  isPrivate Boolean             @default(false)
  replies   ConsultationReply[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@map("topik_konsultasi")
}

model ConsultationReply {
  id           String            @id @default(cuid())
  topicId      String
  topic        ConsultationTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId     String
  author       User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyText    String            @db.Text
  isAdminReply Boolean           @default(false)
  createdAt    DateTime          @default(now())

  @@map("balasan_konsultasi")
}

model FigureProfile {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  position      String?  // e.g. Pustakawan Ahli Utama
  unitKerja     String?  // e.g. Deputi Bidang Pengembangan Bahan Pustaka
  quote         String?  @db.Text // Kutipan inspiratif
  fullStory     String?  @db.LongText // Cerita perjalanan dan kontribusi
  deskripsi     String?  @db.LongText // Deskripsi tokoh
  photoUrl      String?  @db.Text
  achievements  String?  @db.Text // JSON string or structured text of achievements
  careerHistory String?  @db.Text // Riwayat karier & jabatan penting
  isSpotlight   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("profil_tokoh")
}

model HomepageSetting {
  id                 String   @id @default(cuid())
  heroTitle          String   @default("Selamat Datang di Portal Intranet Perpusnas RI")
  heroSubtitle       String   @default("Pusat Informasi Internal, Kolaborasi, dan Layanan Terintegrasi Pegawai Perpustakaan Nasional Republik Indonesia") @db.VarChar(1000)
  heroBadge          String   @default("Kiprah Literasi Bangsa")
  heroBannerUrl      String?  @db.Text
  quoteText          String   @default("Membaca adalah jembatan emas menuju peradaban bangsa yang unggul dan berkarakter.") @db.VarChar(1000)
  quoteAuthor        String   @default("Prof. Dr. Ir. Muhammad Syarif Bando, M.M.")
  quoteAuthorRole    String   @default("Kepala Perpustakaan Nasional RI (Periode 2016-2023)")
  announcementTicker String?  @default("Pemberitahuan: Seluruh pegawai dihimbau melengkapi data profil kepegawaian terkini sebelum akhir bulan.") @db.VarChar(1000)
  updatedAt          DateTime @updatedAt

  @@map("pengaturan_beranda")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, CHANGE_ROLE, CHANGE_STATUS
  module      String // AUTH, USERS, ROLES, HOMEPAGE, NEWS, ANNOUNCEMENTS, AGENDAS, DOCUMENTS, POSTS, FIGURE, PERMISSIONS
  targetId    String?
  description String   @db.Text
  ipAddress   String?  @default("127.0.0.1")
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())

  @@map("log_aktivitas")
}

// ==========================================
// MODEL TABEL KHUSUS SESUAI SUB MENU WEB
// ==========================================

// Sub Menu: Kabar Kedinasan -> Berita
model Berita {
  id            String   @id @default(cuid())
  judul         String   @db.VarChar(255)
  slug          String   @unique @db.VarChar(255)
  ringkasan     String?  @db.Text
  isi           String   @db.LongText
  gambarSampul  String?  @map("gambar_sampul") @db.Text
  penulisId     String   @map("penulis_id")
  penulis       User     @relation("BeritaAuthor", fields: [penulisId], references: [id], onDelete: Cascade)
  namaPenulis   String?  @default("Humas Perpusnas") @map("nama_penulis") @db.VarChar(191)
  sumber        String?  @default("www.perpusnas.go.id") @db.VarChar(255)
  status        String   @default("TERBIT") @db.VarChar(50) // TERBIT, MENUNGGU, DRAFT, ARSIP
  tanggalTerbit DateTime @default(now()) @map("tanggal_terbit")
  jumlahBaca    Int      @default(0) @map("jumlah_baca")
  disematkan    Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("berita")
}

// Sub Menu: Kabar Kedinasan -> Pengumuman
model Pengumuman {
  id            String   @id @default(cuid())
  judul         String   @db.VarChar(255)
  slug          String   @unique @db.VarChar(255)
  ringkasan     String?  @db.Text
  isi           String   @db.LongText
  fileLampiran  String?  @map("file_lampiran") @db.Text
  namaLampiran  String?  @map("nama_lampiran") @db.VarChar(255)
  ukuranFile    String?  @map("ukuran_file") @db.VarChar(50)
  penulisId     String   @map("penulis_id")
  penulis       User     @relation("PengumumanAuthor", fields: [penulisId], references: [id], onDelete: Cascade)
  namaPenulis   String?  @default("Biro SDM Perpusnas") @map("nama_penulis") @db.VarChar(191)
  status        String   @default("TERBIT") @db.VarChar(50)
  tanggalTerbit DateTime @default(now()) @map("tanggal_terbit")
  disematkan    Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("pengumuman")
}

// Sub Menu: Kabar Kedinasan -> Agenda Kegiatan
model AgendaKegiatan {
  id             String    @id @default(cuid())
  namaKegiatan   String    @map("nama_kegiatan") @db.VarChar(255)
  slug           String    @unique @db.VarChar(255)
  deskripsi      String    @db.LongText
  tanggalMulai   DateTime  @map("tanggal_mulai")
  tanggalSelesai DateTime? @map("tanggal_selesai")
  lokasi         String?   @db.VarChar(255)
  gambarSampul   String?   @map("gambar_sampul") @db.Text
  penulisId      String    @map("penulis_id")
  penulis        User      @relation("AgendaAuthor", fields: [penulisId], references: [id], onDelete: Cascade)
  status         String    @default("TERBIT") @db.VarChar(50)
  tanggalTerbit  DateTime  @default(now()) @map("tanggal_terbit")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("agenda_kegiatan")
}

// Sub Menu: Kabar Kedinasan -> Laporan Perjalanan Dinas
model LaporanPerjalananDinas {
  id             String   @id @default(cuid())
  judulLaporan   String   @map("judul_laporan") @db.VarChar(255)
  slug           String   @unique @db.VarChar(255)
  kotaTujuan     String   @map("kota_tujuan") @db.VarChar(255)
  ringkasan      String?  @db.Text
  laporanLengkap String   @map("laporan_lengkap") @db.LongText
  fileLaporan    String?  @map("file_laporan") @db.Text
  namaFile       String?  @map("nama_file") @db.VarChar(255)
  penulisId      String   @map("penulis_id")
  penulis        User     @relation("LaporanAuthor", fields: [penulisId], references: [id], onDelete: Cascade)
  status         String   @default("TERBIT") @db.VarChar(50)
  tanggalTerbit  DateTime @default(now()) @map("tanggal_terbit")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("laporan_perjalanan_dinas")
}

// Sub Menu: Kabar Kedinasan -> Dokumen Intern
model DokumenIntern {
  id              String   @id @default(cuid())
  namaDokumen     String   @map("nama_dokumen") @db.VarChar(255)
  slug            String   @unique @db.VarChar(255)
  deskripsi       String?  @db.Text
  kategoriDokumen String?  @default("Pedoman & SOP") @map("kategori_dokumen") @db.VarChar(100)
  fileUrl         String?  @map("file_url") @db.Text
  namaFile        String?  @map("nama_file") @db.VarChar(255)
  ukuranFile      String?  @map("ukuran_file") @db.VarChar(50)
  penulisId       String   @map("penulis_id")
  penulis         User     @relation("DokumenAuthor", fields: [penulisId], references: [id], onDelete: Cascade)
  status          String   @default("TERBIT") @db.VarChar(50)
  tanggalTerbit   DateTime @default(now()) @map("tanggal_terbit")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("dokumen_intern")
}

// Sub Menu: Kupas Sosok
model KupasSosok {
